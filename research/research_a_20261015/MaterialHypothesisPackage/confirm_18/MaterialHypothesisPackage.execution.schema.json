        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "format": {
          "enum": [
            "npy",
            "npz",
            "hdf5",
            "zarr",
            "json"
          ]
        },
        "key": {

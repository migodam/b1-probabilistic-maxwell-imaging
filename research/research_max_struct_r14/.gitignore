# Full raw fields/candidates/checkpoints/queues remain in lossless Release shards.
/RESULTS/
/queues/
/predictions/
/exports/
/archives/
*.npz
*.npy
*.pt
*.zip
*.log
*.lock
*.tmp
__pycache__/
*.pyc
# Public input arrays are in source/config/public Release; keep public metadata.
/data_public/**/*.npz
# Never publish operational secrets, sealed materials or cached conversations.
/private_operational/
/sealed_truth/
/sources/CHAT_READBACK*
/sources/*CHAT*READBACK*
/sources/*cached*chat*
/TASK_RESUME.md
# Third-party downloaded fulltexts are not project-owned release artifacts.
/audit/prior_art/fulltext/
# Superseded and redundant derived tables stay in the complete diagnostics ZIP.
/audit/cost_ledger_partial_*/
/audit/dynamics_pilot_v1/
/analysis/exposed48_v1/
/audit/cost_ledger_solver_complete_v1/TYPED_STATE_FIELDS.csv
/audit/cost_ledger_solver_complete_v1/COST_LEDGER.json
/audit/dynamics_all192_v1/SOURCE_CONFIGURATIONS.*

# Large complete paid/native histories stay unchanged in final Release volumes.
/analysis/**/NATIVE_STAGE_HISTORY.json
/analysis/**/NATIVE_STAGE_HISTORY.csv
/analysis/**/PAID_CANDIDATE_HISTORY.json
/analysis/**/PAID_CANDIDATE_HISTORY.csv

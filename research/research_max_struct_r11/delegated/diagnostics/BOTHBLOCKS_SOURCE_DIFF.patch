+def feedback_current_maps(operator,U,green,m,beta,JD,E,GJD,cost):
+    """Fixed-material H, its matched adjoint and affine T; one retained small LU."""
+    operator.cost=cost
+    factor=operator.factor(m,beta)
+    cost['current_feedback_factorizations']+=1
+    def H_action(coefficients):
+        ua=U.apply(coefficients)
+        return beta*operator.solve(factor,ua-m[:,None]*green.apply(ua))
+    def H_adjoint(z):
+        v=operator.solve(factor,z,adjoint=True)
+        return beta*U.adjoint(v-green.adjoint(m[:,None]*v))
+    T=beta*operator.solve(factor,JD-m[:,None]*(E+GJD))
+    return H_action,H_adjoint,T
+

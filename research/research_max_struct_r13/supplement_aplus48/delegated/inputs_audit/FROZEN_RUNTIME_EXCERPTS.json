      },
      {
        "line": 53,
        "text": "    \"\"\"Run inherited G19 with one changed admissible current family."
      },
      {
        "line": 54,
        "text": ""
      },
      {
        "line": 55,
        "text": "    Required config is the R12/R8 ``arm_config('a_plus', ...)`` dictionary"
      },
      {
        "line": 56,
        "text": "    including fft_geometry and receipt_path (or a prepared matrix_denominator)."
      },
      {
        "line": 57,
        "text": "    All stages, beta values, prior, weights, bounds and PR settings are retained;"
      },
      {
        "line": 58,
        "text": "    only ``mf`` is set to the full mask for the two full modes. The caller owns"
      },
      {
        "line": 67,
        "text": ""
      },
      {
        "line": 68,
        "text": "    ``g19=False`` reuses the same audit scheduler for inherited CIE/Dual/Global"
      },
      {
        "line": 69,
        "text": "    or an explicitly supplied A+ readout. It never substitutes G19 material"
      },
      {
        "line": 70,
        "text": "    readout into CIE. For a strict algorithm control retain the original config."
      },
      {
        "line": 71,
        "text": "    On budget exceptions, callbacks already received all eligible incumbents;"
      },
      {
        "line": 110,
        "text": "    if g19 and arm != 'a_plus':"
      },
      {
        "line": 111,
        "text": "        raise ValueError('G19 requires original a_plus/global PR config; use g19=False for inherited CIE')"
      },
